# ========== JWT 加密 ==========
SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== 数据库 ==========
DATABASE_URL="mysql+aiomysql://user:password@127.0.0.1:3306/smart_grader?charset=utf8mb4"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ========== Celery / Redis ==========
SYNC_DATABASE_URL="mysql+pymysql://user:password@127.0.0.1:3306/smart_grader?charset=utf8mb4"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/1"

# ========== 任务重试 ==========
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF=10
TASK_RETRY_BACKOFF_MAX=600

# ========== 大模型 API (OpenAI 兼容接口：DeepSeek / Qwen / GPT 等) ==========
LLM_API_KEY="your_llm_api_key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL_NAME="gpt-4o"
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60
LLM_CONCURRENCY=5

# ========== 阿里云 OSS ==========
OSS_ENDPOINT="oss-cn-beijing.aliyuncs.com"
OSS_BUCKET_NAME="your_bucket"
OSS_ACCESS_KEY_ID="your_access_key_id"
OSS_ACCESS_KEY_SECRET="your_access_key_secret"

# ---------- OCR 引擎选择 ----------
# "aliyun" 或 "baidu"
OCR_ENGINE="baidu"

# ---------- 阿里云 OCR 配置 ----------
ALIBABA_CLOUD_ACCESS_KEY_ID="your_access_key_id"
ALIBABA_CLOUD_ACCESS_KEY_SECRET="your_access_key_secret"
ALIBABA_CLOUD_ENDPOINT="cn-hangzhou.aliyuncs.com"

# ---------- 百度云 OCR 配置 ----------
BAIDU_CLOUD_API_KEY="your_api_key"
BAIDU_CLOUD_SECRET_KEY="your_secret_key"

# ---------- 百度云智能作业批改配置 ----------
BAIDU_HOMEWORK_ENABLED="true"
BAIDU_HOMEWORK_POLL_TIMEOUT=180
BAIDU_HOMEWORK_POLL_INTERVAL=2.0
BAIDU_HOMEWORK_LLM_REVIEW="true"
BAIDU_HOMEWORK_AUTO_REVIEW="true"

# ---------- LLM 批改策略配置 ----------
# text_only : 纯文本 | multimodal : 多模态（图片+文本）
LLM_GRADING_STRATEGY="multimodal"

# ---------- 图像处理管道配置 ----------
# grayscale             灰度化
# threshold             二值化
# denoise               降噪
# crop                  去黑边
# enhance               文字增强
# deskew                倾斜校正
# light_equalize        光照均衡
# background_remove     背景去除
IMAGE_PIPELINE_STEPS="grayscale,denoise(method=bilateral,d=9),light_equalize,crop(padding=20),deskew,background_remove,enhance(method=morphology)"
